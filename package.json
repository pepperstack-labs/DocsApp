{
  "name": "docsapp",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @docsapp/api\" \"npm run dev -w @docsapp/web\"",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test": "npm run test -w @docsapp/api",
    "test:db": "npm run test:db -w @docsapp/api",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "supabase": "2.122.0",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3"
  }
}
